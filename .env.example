# URL base do GLPI, sem /apirest.php
GLPI_URL=https://glpi.suaempresa.com.br
# Token do cliente de API criado pelo administrador
GLPI_APP_TOKEN=
# Prefira o token pessoal de API do usuário
GLPI_USER_TOKEN=
# Alternativa, apenas se o administrador habilitar login por credenciais
GLPI_LOGIN=
GLPI_PASSWORD=
# Defina como 1 para ocultar tools que alteram dados
GLPI_READ_ONLY=1
